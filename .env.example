# RegCompass environment template. Copy to .env and fill in only what you need.
# Every variable below is OPTIONAL: with an empty .env the tool starts and serves
# the interface, and a Run needs either a key for a declared Engine or the offline
# fake Engine. NEVER commit a real key: .env is gitignored and the tree is
# gitleaks-scanned in CI.

# The API key for both declared Engines. Engine A (GPT-5.6 Luna) and Engine B
# (Qwen3-30B-A3B-Instruct-2507) are both served through OpenRouter, so both name
# OPENROUTER_API_KEY as their `api_key_env` in config/models.yaml. Optional: a key
# is needed only to run a declared Engine, and it can also be typed into Settings
# in the interface instead of written here. `regcompass engines` says whether it is
# set, never its value.
OPENROUTER_API_KEY=

# Where the local Ollama server listens. Ollama serves the embedder the Gate uses,
# and any Engine repointed at a local checkpoint. Optional: the code default is
# http://localhost:11434, and docker-compose sets it to http://ollama:11434 for the
# container, so you normally leave this commented out.
# OLLAMA_HOST=

# The SQLite working database the server reads and writes. Optional: default
# data/regcompass.db on a host install, /data/regcompass.db under docker-compose.
# REGCOMPASS_DB=

# The directory exported workbooks and CSVs are written to. Optional: default out/
# on a host install, /data/out under docker-compose.
# REGCOMPASS_OUT=

# The root holding each Economy's downloaded Document bytes. Optional: default
# data/ on a host install, /data under docker-compose.
# REGCOMPASS_DATA=

# Nothing else is read from .env by the running tool. REGCOMPASS_PAID,
# REGCOMPASS_LIVE, REGCOMPASS_PG_DSN, REGCOMPASS_DOCKER_BUILD and
# REGCOMPASS_UPDATE_SNAPSHOTS are opt-in switches for the test suite only; set them
# in the shell for the one command that needs them rather than here.
